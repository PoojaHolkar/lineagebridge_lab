# Copy to .env and fill in. Keep it at mode 600 and never commit it.
#
#   cp .env.example .env && chmod 600 .env

# ── Confluent Cloud ──────────────────────────────────────────────────────
# Organization-level key, created under Home > API keys with the "My account"
# scope. A cluster-scoped key will not provision the demo.
LINEAGE_BRIDGE_CONFLUENT_CLOUD_API_KEY=
LINEAGE_BRIDGE_CONFLUENT_CLOUD_API_SECRET=

# ── Filled in after `terraform apply` ────────────────────────────────────
# See `terraform output`. The Kafka key is not exposed as an output - read it
# from terraform.tfstate, resource `confluent_api_key.kafka`.
LINEAGE_BRIDGE_SCHEMA_REGISTRY_ENDPOINT=
LINEAGE_BRIDGE_SCHEMA_REGISTRY_API_KEY=
LINEAGE_BRIDGE_SCHEMA_REGISTRY_API_SECRET=

LINEAGE_BRIDGE_FLINK_API_KEY=
LINEAGE_BRIDGE_FLINK_API_SECRET=

LINEAGE_BRIDGE_KAFKA_API_KEY=
LINEAGE_BRIDGE_KAFKA_API_SECRET=

# ── IBM watsonx.data intelligence ────────────────────────────────────────
# Only used by watsonx_lineage_repro.py. The IBM Cloud key must belong to a
# user, not a service ID - the HTTP ingestion API requires that.
LINEAGE_BRIDGE_WATSONX_HOST=
LINEAGE_BRIDGE_WATSONX_API_KEY=

# Second profile, reached with `--profile ca-tor`.
LINEAGE_BRIDGE_WATSONX_CA_TOR_HOST=
LINEAGE_BRIDGE_WATSONX_CA_TOR_API_KEY=
